Screen {
    background: $background;
    overflow-y: hidden;
}

GradientTitle {
    height: 1;
    content-align: center middle;
    margin-bottom: 1;
}

HintBar {
    height: 1;
    dock: bottom;
    padding: 0 2;
}

.panel {
    border: round $border-muted;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
}

.panel:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

Button {
    min-width: 10;
    text-style: bold;
}

Checkbox {
    margin-right: 2;
}

RunPane {
    padding: 1 2;
    height: 1fr;
}

.run-form-row {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

.run-form-row Label {
    width: auto;
    padding: 0 1 0 0;
    content-align: left middle;
}

.run-form-row Button {
    margin-right: 2;
}

#binary_input {
    width: 1fr;
}

#provider_select {
    width: 20;
    margin-right: 1;
}

#passes_input, #limit_input {
    width: 8;
    margin-right: 2;
}

#configure_panel {
    height: auto;
    margin-bottom: 1;
}

#progress_panel {
    height: 1fr;
}

#progress {
    margin-bottom: 1;
    width: 1fr;
}

#log {
    height: 1fr;
    border: none;
}

ResultsPane {
    height: 1fr;
    padding: 1 2;
}

#load_panel {
    height: auto;
    margin-bottom: 1;
}

#results_load_row {
    height: auto;
    align: left middle;
}

#results_binary_input {
    width: 1fr;
    margin-right: 1;
}

#results_body {
    height: 1fr;
}

#table_panel {
    width: 40%;
    height: 1fr;
    margin-right: 1;
}

#fn_table {
    width: 1fr;
    height: 1fr;
}

#code_panes {
    width: 60%;
    height: 1fr;
}

.code_pane {
    width: 1fr;
    height: 1fr;
    overflow: auto;
}

#before_panel {
    margin-right: 1;
}
