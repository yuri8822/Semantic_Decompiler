# ── Secrets ────────────────────────────────────────────────────────────────
.env

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/
.Python

# ── Project runtime data ────────────────────────────────────────────────────
# SQLite database (rebuilt on each run)
semantic.db
semantic.db-wal
semantic.db-shm

# Ghidra JSON exports (large, binary-specific, regenerated by Ghidra)
data/ghidra_json/

# Input binaries (don't commit third-party executables)
data/binaries/

# AI-generated output (reproducible from source + binary)
output/recovered/

# ── Ghidra project files ────────────────────────────────────────────────────
# The .gpr and .rep are local workspace state, not source
ghidra_project/

# ── Vendored inference engines ──────────────────────────────────────────────
# PrismML's llama.cpp fork (Bonsai 1-bit support) — built locally, not source
llama.cpp/

# Model weights (large, downloaded separately)
*.gguf

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS ──────────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
